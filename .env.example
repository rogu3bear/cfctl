# Canonical shared source of truth lives in ~/.config/cfctl/.env by default.
# This file exists to document the contract only.
#
# Workspace fallback: cfctl also strict-imports CF_WORKSPACE_ENV_FILE
# (default ~/dev/.env) — KEY=VALUE lines only, never executed as shell,
# allowlisted to lane credentials + lane requirements + CLOUDFLARE_ACCOUNT_ID,
# and it fills gaps only (values from ~/.config/cfctl/.env or .env.local win).
# Set CF_WORKSPACE_ENV_FILE="" to disable. Inspect with: cfctl env sources
#
# Note: the repo override file is .env.local; a repo-root .env is NOT read.

CF_DEV_TOKEN=
CF_GLOBAL_TOKEN=
CLOUDFLARE_ACCOUNT_ID=

# Select dev by default; set to global only for emergency wider-scope operations.
CF_TOKEN_LANE=dev

# Required for the emergency global lane.
CLOUDFLARE_EMAIL=

# Derived compatibility env for Wrangler wrappers.
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_API_KEY=

# Access service tokens are only for calling Access-protected applications.
CLOUDFLARE_ACCESS_CLIENT_ID=
CLOUDFLARE_ACCESS_CLIENT_SECRET=

# Tunnel runtime values when operating cloudflared directly.
CF_TUNNEL_ID=
CF_TUNNEL_TOKEN=
