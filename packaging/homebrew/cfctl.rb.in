class Cfctl < Formula
  desc "Universal governed Cloudflare control plane"
  homepage "https://cfctl.io"
  version "@VERSION@"
  license "MIT"

  on_macos do
    if Hardware::CPU.arm?
      url "https://github.com/rogu3bear/cfctl/releases/download/v@VERSION@/cfctl-aarch64-apple-darwin"
      sha256 "@AARCH64_APPLE_SHA256@"
    else
      url "https://github.com/rogu3bear/cfctl/releases/download/v@VERSION@/cfctl-x86_64-apple-darwin"
      sha256 "@X86_64_APPLE_SHA256@"
    end
  end

  def install
    bin.install Dir["cfctl-*"][0] => "cfctl"
  end

  test do
    assert_match version.to_s, shell_output("#{bin}/cfctl --version")
  end
end
