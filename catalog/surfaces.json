    "access.service_token": {
      "description": "Cloudflare Access service tokens (non-identity machine credentials) in the pinned account. Minted client_secret is delivered once to a --value-out sink.",
      "backend": "inventory_script",
      "inventory_script": "scripts/cf_inventory_access_service_tokens.sh",
      "apply_script": "scripts/cf_mutate_access_service_token.sh",
      "permission_family": "Access: Service Tokens",
      "probe": {
        "method": "GET",
        "path_template": "/accounts/{account_id}/access/service_tokens"
      },
      "selectors": ["id", "name", "client_id"],
      "actions": {
        "list": { "supported": true },
        "get": { "supported": true, "selectors_any_of": [["id"], ["name"], ["client_id"]] },
        "verify": { "supported": true, "selectors_any_of": [["id"], ["name"], ["client_id"]] },
        "can": { "supported": true },
        "apply": {
          "supported": true,
          "operations": {
            "create": { "risk": "write", "required_selectors": ["name"] },
            "delete": { "risk": "destructive", "required_selectors": ["id"], "confirm": "delete" }
          }
        }
      },
      "examples": [
        "CF_TOKEN_LANE=global ./cfctl list access.service_token",
        "CF_TOKEN_LANE=global ./cfctl apply access.service_token create --name founder-lead-ingest-forwarders --value-out /tmp/li_st_secret --plan",
        "CF_TOKEN_LANE=global ./cfctl apply access.service_token create --name founder-lead-ingest-forwarders --value-out /tmp/li_st_secret --ack-plan <operation-id>",
        "CF_TOKEN_LANE=global ./cfctl apply access.service_token delete --id <token-id> --plan"
      ]
    },
