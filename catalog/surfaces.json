    "worker.script": {
      "description": "Workers scripts in the pinned account. Upsert uploads a multipart bundle (metadata.json + main module). Container/DO migrations live in the metadata payload; the operator owns bundling (e.g. via bun build) before invoking apply.",
      "module": "worker_script",
      "backend": "inventory_script",
      "inventory_script": "scripts/cf_inventory_workers.sh",
      "apply_script": "scripts/cf_mutate_worker_script.sh",
      "permission_family": "Workers",
      "probe": {
        "method": "GET",
        "path_template": "/accounts/{account_id}/workers/scripts"
      },
      "selectors": ["id", "name", "metadata", "module"],
      "actions": {
        "list": {
          "supported": true
        },
        "get": {
          "supported": true,
          "selectors_any_of": [["id"], ["name"]]
        },
        "verify": {
          "supported": true,
          "selectors_any_of": [["id"], ["name"]]
        },
        "can": {
          "supported": true
        },
        "apply": {
          "supported": true,
          "operations": {
            "upsert": {
              "risk": "write",
              "required_selectors": ["name", "metadata", "module"]
            },
            "delete": {
              "risk": "destructive",
              "required_selectors": ["name"],
              "confirm": "delete"
            }
          }
        }
      },
      "examples": [
        "./cfctl list worker.script",
        "./cfctl get worker.script --name founder",
        "./cfctl apply worker.script upsert --name hello --metadata /tmp/meta.json --module /tmp/index.js --plan",
        "./cfctl apply worker.script upsert --name hello --metadata /tmp/meta.json --module /tmp/index.js --ack-plan <operation-id>",
        "./cfctl apply worker.script delete --name hello --plan",
        "./cfctl apply worker.script delete --name hello --ack-plan <operation-id> --confirm delete"
      ]
    },
