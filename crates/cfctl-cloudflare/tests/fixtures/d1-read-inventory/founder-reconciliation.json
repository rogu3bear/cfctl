      "id": "current-entity-entries",
      "sql": "SELECT de.entry_key, CASE WHEN (typeof(de.value_json) = 'text' AND json_valid(de.value_json)) THEN json_type(de.value_json) ELSE 'invalid' END AS json_kind, CASE WHEN (typeof(de.value_json) = 'text' AND json_valid(de.value_json)) THEN COALESCE(json_type(json_patch('{}', de.value_json), '$.de_file_number'), 'missing') ELSE 'missing' END AS de_file_number_kind, CASE WHEN (typeof(de.value_json) = 'text' AND json_valid(de.value_json)) THEN CASE WHEN json_type(json_patch('{}', de.value_json), '$.de_file_number') = 'text' THEN json_extract(json_patch('{}', de.value_json), '$.de_file_number') ELSE NULL END ELSE NULL END AS de_file_number, CASE WHEN de.entry_key = 'entity_profile' THEN CASE WHEN (typeof(de.value_json) = 'text' AND json_valid(de.value_json)) THEN COALESCE(json_type(json_patch('{}', de.value_json), '$.mailing_address_line'), 'missing') ELSE 'missing' END ELSE 'missing' END AS mailing_address_kind, CASE WHEN de.entry_key = 'entity_profile' THEN CASE WHEN (typeof(de.value_json) = 'text' AND json_valid(de.value_json)) THEN CASE WHEN json_type(json_patch('{}', de.value_json), '$.mailing_address_line') = 'text' THEN json_extract(json_patch('{}', de.value_json), '$.mailing_address_line') ELSE NULL END ELSE NULL END ELSE NULL END AS mailing_address_line FROM dataset_entries de JOIN datasets d ON d.id = de.dataset_id WHERE d.org_id = ?1 AND d.slug = 'company_profile' AND d.is_active = 1 AND de.superseded_at IS NULL AND de.entry_key IN ('entity_profile', 'kansas_entity') ORDER BY COALESCE(de.effective_at, de.created_at) DESC, de.created_at DESC, de.id DESC",
