                  "public"
                ],
                "type": "string"
              }
            },
            "type": "object"
          }
        ],
        "description": "Partial update request for an OAuth client. Only include fields you want to update.",
        "title": "Update OAuth Client Request"
      },
      "iam_oauth_client_uri_verification": {
        "description": "Client URI domain control verification state.",
        "properties": {
          "status": {
