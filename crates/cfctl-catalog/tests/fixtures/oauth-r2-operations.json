        "allOf": [
          {
            "$ref": "#/components/schemas/iam_oauth_client_common"
          },
          {
            "properties": {
              "visibility": {
                "description": "Promote the OAuth client from private to public visibility. Only `public` is accepted; demotion to `private` is not supported. Promotion requires a non-empty client name, logo URI, verified client URI host, and at least one non-identity scope.",
