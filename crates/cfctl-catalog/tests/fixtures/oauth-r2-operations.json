              "type": "string"
            },
            "type": "array",
            "x-auditable": true
          },
          "token_endpoint_auth_method": {
            "$ref": "#/components/schemas/iam_oauth_client_token_endpoint_auth_method"
          },
          "tos_uri": {
            "description": "URL that points to a terms of service document.",
            "type": "string",
            "x-auditable": true
